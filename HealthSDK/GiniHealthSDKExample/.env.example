# Health example app credentials — copy this file to .env.local (gitignored) and fill in your values.
# The build phase on the GiniHealthSDKExample target reads .env.local and generates
# Credentials.swift into $(SRCROOT)/Generated on every build.
#
# The hook at .githooks/pre-commit rejects commits that stage .env.local.
# Activate it once per clone with:
#   git config core.hooksPath .githooks

# Gini client credentials — ask your tech lead for the current values.
GINI_CLIENT_ID=
GINI_CLIENT_PASSWORD=
GINI_CLIENT_DOMAIN=gini.net

# Firebase API key for the example app's GoogleService-Info.plist (API_KEY field).
FIREBASE_API_KEY=
