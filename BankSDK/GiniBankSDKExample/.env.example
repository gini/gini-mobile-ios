# Example app credentials — copy this file to .env.local (gitignored) and fill in your values.
# The build phase on each Bank example target reads .env.local and generates
# Credentials.swift into DerivedData on every build.
#
# The hook at .githooks/pre-commit rejects commits that stage .env.local or any
# */Credentials.plist. Activate it once per clone with:
#   git config core.hooksPath .githooks

# Gini Bank client credentials — ask your tech lead for the current values.
GINI_CLIENT_ID=
GINI_CLIENT_PASSWORD=
GINI_CLIENT_DOMAIN=gini.net

# Cross-border payment client credentials — same source as above.
GINI_CX_CLIENT_ID=
GINI_CX_CLIENT_PASSWORD=

# Staging client credentials — optional (local dev only, CI does not exercise them).
# Fill in to drive the "Stage" toggle in the example app's Settings > Credentials Set.
GINI_STAGE_CLIENT_ID=
GINI_STAGE_CLIENT_PASSWORD=

# Firebase API key for the example apps' GoogleService-Info.plist (API_KEY field).
FIREBASE_API_KEY=
